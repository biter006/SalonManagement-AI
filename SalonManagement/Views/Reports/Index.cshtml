@model ReportViewModel
@{ ViewData["Title"] = "Báo cáo"; }
<h1 class="page-title h2 mb-3">Báo cáo hoạt động</h1><form class="card card-body mb-4" method="get"><div class="row g-2 align-items-end"><div class="col-md-4"><label class="form-label">Từ ngày</label><input type="date" name="fromDate" value="@Model.FromDate.ToString("yyyy-MM-dd")" class="form-control"/></div><div class="col-md-4"><label class="form-label">Đến ngày</label><input type="date" name="toDate" value="@Model.ToDate.ToString("yyyy-MM-dd")" class="form-control"/></div><div class="col-md-2"><button class="btn btn-primary w-100">Xem báo cáo</button></div></div></form><div class="card metric-card p-4 mb-4"><div class="text-muted">Tổng doanh thu đã thanh toán</div><div class="display-6 fw-bold">@Model.TotalRevenue.ToString("N0")đ</div></div><div class="row g-4"><div class="col-lg-7"><div class="card p-4"><h5>Doanh thu theo ngày</h5><canvas id="reportRevenue"></canvas></div></div><div class="col-lg-5"><div class="card p-4"><h5>Dịch vụ phổ biến</h5><ul class="list-group list-group-flush">@foreach(var x in Model.PopularServices){<li class="list-group-item d-flex justify-content-between"><span>@x.Label</span><strong>@x.Value lượt</strong></li>}</ul></div></div><div class="col-12"><div class="card p-4"><h5>Khách hàng quay lại (từ 2 lần hoàn thành)</h5><table class="table table-sm mb-0"><tbody>@foreach(var x in Model.ReturningCustomers){<tr><td>@x.CustomerName</td><td>@x.CompletedVisits</td></tr>}@if(!Model.ReturningCustomers.Any()){<tr><td colspan="2" class="text-muted">Chưa có khách thỏa điều kiện.</td></tr>}</tbody></table></div></div></div><script src="https://cdn.jsdelivr.net/npm/chart.js"></script><script>const data=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueByDay));new Chart(document.getElementById('reportRevenue'),{type:'bar',data:{labels:data.map(x=>x.Label),datasets:[{label:'VNĐ',data:data.map(x=>x.Value),backgroundColor:'#b36f8d'}]},options:{plugins:{legend:{display:false}}}});</script>
