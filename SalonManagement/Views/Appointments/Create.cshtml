@model AppointmentFormViewModel
@{ ViewData["Title"] = "Đặt lịch"; }
<div class="card form-card p-4"><h1 class="page-title h3">Đặt lịch hẹn</h1><p class="text-muted">Hệ thống kiểm tra ca làm việc và lịch trùng trước khi lưu.</p><form asp-action="Create"><partial name="_Form" model="Model"/><div class="mt-4"><button class="btn btn-primary">Tạo lịch hẹn</button><a class="btn btn-link" asp-action="Index">Hủy</a></div></form></div><script>document.getElementById('serviceSelect').addEventListener('change',async function(){if(!this.value)return;let r=await fetch('@Url.Action("ServiceDuration")?id='+this.value);if(r.ok){let d=await r.json();document.getElementById('endPreview').textContent='Thời lượng dịch vụ: '+d.durationMinutes+' phút. Giờ kết thúc sẽ tự tính.';}});</script>
