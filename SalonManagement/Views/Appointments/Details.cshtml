@model AppointmentDetailsViewModel
@{ ViewData["Title"]="Chi tiết lịch hẹn"; var x=Model.Appointment; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="page-title h2">Lịch hẹn #@x.Id</h1><span class="badge bg-primary">@x.Status.GetDisplayName()</span></div><div>@if(User.IsInRole("Admin") || User.IsInRole("Receptionist")){<a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@x.Id">Đổi lịch</a>}</div></div><div class="row g-4"><div class="col-lg-7"><div class="card p-4"><dl class="row mb-0"><dt class="col-4">Khách hàng</dt><dd class="col-8"><a asp-controller="Customers" asp-action="Details" asp-route-id="@x.CustomerId">@x.Customer?.FullName</a></dd><dt class="col-4">Dịch vụ</dt><dd class="col-8">@x.Service?.Name</dd><dt class="col-4">Thợ phụ trách</dt><dd class="col-8">@x.Stylist?.FullName</dd><dt class="col-4">Thời gian</dt><dd class="col-8">@x.AppointmentDate.ToString("dd/MM/yyyy") · @x.StartTime.ToString("hh\\:mm") – @x.EndTime.ToString("hh\\:mm")</dd><dt class="col-4">Ghi chú khách</dt><dd class="col-8">@(x.CustomerNote ?? "—")</dd><dt class="col-4">Ghi chú nhân viên</dt><dd class="col-8">@(x.StaffNote ?? "—")</dd></dl></div></div><div class="col-lg-5"><div class="card p-4"><h5>Thao tác</h5>@if(x.Status is AppointmentStatus.Pending or AppointmentStatus.Confirmed){<form asp-action="Complete" class="mb-3"><input type="hidden" name="id" value="@x.Id"/><label class="form-label">Ghi chú sau dịch vụ</label><textarea class="form-control mb-2" name="staffNote"></textarea><button class="btn btn-success">Hoàn thành lịch hẹn</button></form>}@if((User.IsInRole("Admin") || User.IsInRole("Receptionist")) && x.Status is not AppointmentStatus.Completed and not AppointmentStatus.Cancelled){<form asp-action="Cancel"><input type="hidden" name="id" value="@x.Id"/><label class="form-label">Lý do hủy</label><input class="form-control mb-2" name="cancelReason"/><button class="btn btn-outline-danger">Hủy lịch hẹn</button></form>}@if(x.Invoice is null && x.Status == AppointmentStatus.Completed && (User.IsInRole("Admin") || User.IsInRole("Receptionist"))){<a class="btn btn-primary mt-3" asp-controller="Invoices" asp-action="Create">Lập hóa đơn</a>} else if(x.Invoice is not null){<a class="btn btn-outline-secondary mt-3" asp-controller="Invoices" asp-action="Details" asp-route-id="@x.Invoice.Id">Xem hóa đơn</a>}</div></div></div>
