@model AppointmentFormViewModel
<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="CustomerId" class="form-label"></label><select asp-for="CustomerId" asp-items="Model.Customers" class="form-select"><option value="">-- Chọn khách --</option></select><span asp-validation-for="CustomerId" class="text-danger"></span></div><div class="col-md-6"><label asp-for="ServiceId" class="form-label"></label><select asp-for="ServiceId" asp-items="Model.Services" class="form-select" id="serviceSelect"><option value="">-- Chọn dịch vụ --</option></select><span asp-validation-for="ServiceId" class="text-danger"></span></div><div class="col-md-6"><label asp-for="StylistId" class="form-label"></label><select asp-for="StylistId" asp-items="Model.Stylists" class="form-select"><option value="">-- Chọn thợ --</option></select><span asp-validation-for="StylistId" class="text-danger"></span></div><div class="col-md-3"><label asp-for="AppointmentDate" class="form-label"></label><input asp-for="AppointmentDate" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")"/><span asp-validation-for="AppointmentDate" class="text-danger"></span></div><div class="col-md-3"><label asp-for="StartTime" class="form-label"></label><input asp-for="StartTime" class="form-control"/><div id="endPreview" class="form-text">Giờ kết thúc tính theo dịch vụ.</div></div><div class="col-12"><label asp-for="CustomerNote" class="form-label"></label><textarea asp-for="CustomerNote" class="form-control" rows="3"></textarea></div></div>
