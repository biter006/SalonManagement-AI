@model AppointmentFilterViewModel
@{ ViewData["Title"]="Lịch hẹn"; var items = (IEnumerable<Appointment>)ViewBag.Appointments; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="page-title h2">Lịch hẹn</h1>@if(User.IsInRole("Admin") || User.IsInRole("Receptionist")){<a class="btn btn-primary" asp-action="Create">+ Đặt lịch</a>}</div>
<form class="card card-body mb-3" method="get"><div class="row g-2"><div class="col-md"><input asp-for="Date" class="form-control"/></div><div class="col-md"><select asp-for="StylistId" asp-items="Model.Stylists" class="form-select"><option value="">Tất cả thợ</option></select></div><div class="col-md"><select asp-for="CustomerId" asp-items="Model.Customers" class="form-select"><option value="">Tất cả khách</option></select></div><div class="col-md"><select asp-for="Status" asp-items="Html.GetEnumSelectList<AppointmentStatus>()" class="form-select"><option value="">Tất cả trạng thái</option></select></div><div class="col-md-auto"><button class="btn btn-outline-secondary">Lọc</button></div></div></form>
<div class="card p-3 table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Thời gian</th><th>Khách hàng</th><th>Dịch vụ</th><th>Thợ</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var x in items){<tr><td><strong>@x.AppointmentDate.ToString("dd/MM/yyyy")</strong><br/><small>@x.StartTime.ToString("hh\\:mm") – @x.EndTime.ToString("hh\\:mm")</small></td><td>@x.Customer?.FullName</td><td>@x.Service?.Name</td><td>@x.Stylist?.FullName</td><td><span class="badge bg-@(x.Status == AppointmentStatus.Completed ? "success" : x.Status == AppointmentStatus.Cancelled ? "secondary" : "primary")">@x.Status.GetDisplayName()</span></td><td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@x.Id">Chi tiết</a></td></tr>}</tbody></table></div>
