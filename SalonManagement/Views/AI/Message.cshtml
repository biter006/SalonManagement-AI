@model AIMessageViewModel
@{ ViewData["Title"] = "AI tạo tin nhắn"; }
<div class="card form-card p-4"><h1 class="page-title h3">AI tạo tin nhắn chăm sóc</h1><form asp-action="Message" class="mt-3"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="CustomerId" class="form-label"></label><select asp-for="CustomerId" asp-items="Model.Customers" class="form-select" id="CustomerId"><option value="">-- Chọn khách hàng --</option></select></div><div class="mb-3"><label asp-for="AppointmentId" class="form-label"></label><select asp-for="AppointmentId" asp-items="Model.Appointments" class="form-select"><option value="">-- Không gắn lịch hẹn --</option></select><div class="form-text">Tin nhắn nhắc lịch bắt buộc cần chọn lịch hẹn của khách.</div></div><div class="mb-3"><label asp-for="MessageType" class="form-label"></label><select asp-for="MessageType" asp-items="Html.GetEnumSelectList<MessageType>()" class="form-select"></select></div><button class="btn btn-primary">Tạo tin nhắn</button><a class="btn btn-link" asp-action="Index">Quay lại</a></form>@if(!string.IsNullOrWhiteSpace(Model.Result)){<hr/><h5>Nội dung có thể copy và chỉnh sửa</h5><textarea class="form-control" rows="6">@Model.Result</textarea>}</div><script>document.getElementById('CustomerId').addEventListener('change',function(){window.location='@Url.Action("Message")?customerId='+this.value;});</script>
