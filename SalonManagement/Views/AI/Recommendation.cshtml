@model AIRecommendationViewModel
@{ ViewData["Title"] = "AI gợi ý dịch vụ"; }
<div class="card form-card p-4"><h1 class="page-title h3">AI gợi ý dịch vụ</h1><form asp-action="Recommendation" class="mt-3"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="CustomerId" class="form-label"></label><select asp-for="CustomerId" asp-items="Model.Customers" class="form-select"><option value="">-- Chọn khách hàng --</option></select></div><div class="mb-3"><label asp-for="InputText" class="form-label"></label><textarea asp-for="InputText" class="form-control" rows="4" placeholder="Ví dụ: Khách muốn tóc gọn, dễ chăm sóc..."></textarea></div><button class="btn btn-primary">Tạo gợi ý</button><a class="btn btn-link" asp-action="Index">Quay lại</a></form>@if(!string.IsNullOrWhiteSpace(Model.Result)){<hr/><h5>Kết quả</h5><div class="ai-result">@Model.Result</div>}</div>
