@model AIRecommendationViewModel
@{ ViewData["Title"] = "AI tư vấn tóc thông minh"; }
<div class="card form-card p-4">
    <h1 class="page-title h3">AI tư vấn tóc thông minh</h1>
    <div class="alert alert-warning small">Kết quả AI chỉ mang tính tham khảo. Thợ cần kiểm tra tình trạng tóc thực tế trước khi chốt dịch vụ.</div>
    <form asp-action="Recommendation" class="mt-3">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="CustomerId" class="form-label"></label><select asp-for="CustomerId" asp-items="Model.Customers" class="form-select"><option value="">-- Chọn khách hàng --</option></select><span asp-validation-for="CustomerId" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="HairCondition" class="form-label"></label><select asp-for="HairCondition" class="form-select"><option value="">-- Chọn tình trạng --</option><option>Khô, xơ hoặc hư tổn</option><option>Tóc khỏe, bình thường</option><option>Tóc dầu, có gàu hoặc da đầu nhạy cảm</option><option>Đã nhuộm/uốn/tẩy trước đó</option></select><span asp-validation-for="HairCondition" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="DesiredStyle" class="form-label"></label><select asp-for="DesiredStyle" class="form-select"><option value="">-- Chọn mong muốn --</option><option>Tóc gọn, dễ chăm sóc</option><option>Phục hồi tóc</option><option>Uốn/xoăn, tạo độ bồng</option><option>Đổi màu/nhuộm tóc</option><option>Chăm sóc da đầu</option></select><span asp-validation-for="DesiredStyle" class="text-danger small"></span></div>
            <div class="col-md-3"><label asp-for="Budget" class="form-label"></label><input asp-for="Budget" type="number" min="50000" step="10000" class="form-control" placeholder="Ví dụ: 500000" /><span asp-validation-for="Budget" class="text-danger small"></span></div>
            <div class="col-md-3"><label asp-for="MaintenancePreference" class="form-label"></label><select asp-for="MaintenancePreference" class="form-select"><option value="">-- Chọn --</option><option>Ít thời gian chăm sóc</option><option>Có thể chăm sóc cơ bản</option><option>Sẵn sàng chăm sóc kỹ</option></select><span asp-validation-for="MaintenancePreference" class="text-danger small"></span></div>
            <div class="col-12"><label asp-for="InputText" class="form-label"></label><textarea asp-for="InputText" class="form-control" rows="3" maxlength="1000" placeholder="Ví dụ: Khách muốn tóc gọn nhưng vẫn giữ độ dài, đã uốn cách đây 6 tháng..."></textarea><span asp-validation-for="InputText" class="text-danger small"></span><div class="form-text">Tối đa 1.000 ký tự. Chỉ dữ liệu cần thiết cho việc tư vấn.</div></div>
        </div>
        <button class="btn btn-primary mt-3">Phân tích & gợi ý</button><a class="btn btn-link mt-3" asp-action="Index">Quay lại</a>
    </form>
    @if (Model.SuggestedServices.Count > 0)
    {
        <hr /><h5>Dịch vụ phù hợp theo dữ liệu salon</h5>
        <div class="row g-3 mb-3">
            @foreach (var service in Model.SuggestedServices)
            {
                <div class="col-md-4"><div class="border rounded p-3 h-100"><strong>@service.Name</strong><div class="text-primary fw-semibold mt-2">@service.Price.ToString("N0")đ · @service.DurationMinutes phút</div><p class="small text-muted mb-0 mt-2">@service.Reason</p></div></div>
            }
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Result))
    {
        <hr /><h5>Nhận xét AI</h5><div class="ai-result" aria-live="polite">@Model.Result</div>
    }
</div>
