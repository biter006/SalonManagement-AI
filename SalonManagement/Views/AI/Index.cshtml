@{ ViewData["Title"] = "AI Assistant"; }
<div class="mb-4">
    <h1 class="page-title">AI Assistant</h1>
    <p class="text-muted">AI chỉ sử dụng dữ liệu salon đang có. Nhân viên cần kiểm tra kết quả trước khi tư vấn hoặc gửi cho khách.</p>
</div>
<div class="row g-4">
    <div class="col-md-6 col-xl-3"><div class="card p-4 h-100"><h4>✦ Tư vấn tóc thông minh</h4><p class="text-muted">Chấm điểm dịch vụ theo tóc, mong muốn, ngân sách và lịch sử khách.</p><a class="btn btn-primary mt-auto" asp-action="Recommendation">Tư vấn ngay</a></div></div>
    <div class="col-md-6 col-xl-3"><div class="card p-4 h-100"><h4>◉ Chatbot tư vấn</h4><p class="text-muted">Trao đổi theo ngữ cảnh khách hàng để nhân viên trả lời nhanh hơn.</p><a class="btn btn-outline-primary mt-auto" asp-action="Chat">Mở chatbot</a></div></div>
    <div class="col-md-6 col-xl-3"><div class="card p-4 h-100"><h4>✉ Tin nhắn chăm sóc</h4><p class="text-muted">Soạn nhắc lịch, cảm ơn, chăm sóc và mời quay lại để nhân viên chỉnh sửa.</p><a class="btn btn-outline-primary mt-auto" asp-action="Message">Tạo tin nhắn</a></div></div>
    <div class="col-md-6 col-xl-3"><div class="card p-4 h-100"><h4>☰ Tóm tắt lịch sử</h4><p class="text-muted">Nắm nhanh những lần sử dụng dịch vụ và ghi chú của khách.</p><a class="btn btn-outline-primary mt-auto" asp-action="Summary">Tạo tóm tắt</a></div></div>
</div>
