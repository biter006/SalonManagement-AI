@model AccountProfileViewModel
@{ ViewData["Title"] = "Tài khoản của tôi"; }
<div class="card form-card p-4">
    <h1 class="page-title h3">Tài khoản của tôi</h1>
    <p class="text-muted">Thông tin đăng nhập và quyền truy cập trong hệ thống.</p>
    <dl class="row mt-4">
        <dt class="col-sm-4">Tên đăng nhập</dt><dd class="col-sm-8">@Model.Email</dd>
        <dt class="col-sm-4">Vai trò</dt><dd class="col-sm-8">@string.Join(", ", Model.Roles)</dd>
    </dl>
    <div class="d-flex gap-2 mt-2">
        <a class="btn btn-primary" asp-action="ChangePassword">Đổi mật khẩu</a>
        @if (User.IsInRole("Admin")) { <a class="btn btn-outline-secondary" asp-controller="Users" asp-action="Index">Quản lý người dùng</a> }
    </div>
</div>
