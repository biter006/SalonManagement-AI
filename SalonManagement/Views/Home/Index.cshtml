@model DashboardViewModel
@{ ViewData["Title"] = "Trang tổng quan"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="page-title mb-0">Hệ thống quản lý Salon tích hợp AI</h1><p class="text-muted mb-0">Trang tổng quan hoạt động của salon hôm nay</p></div><a class="btn btn-primary" asp-controller="Appointments" asp-action="Create">+ Đặt lịch mới</a></div>
<div class="row g-3 mb-4">
    <div class="col-6 col-lg"><div class="card metric-card p-3"><div class="small text-muted">Khách hàng</div><div class="metric-number">@Model.CustomerCount</div></div></div>
    <div class="col-6 col-lg"><div class="card metric-card p-3"><div class="small text-muted">Lịch hôm nay</div><div class="metric-number">@Model.AppointmentsToday</div></div></div>
    <div class="col-6 col-lg"><div class="card metric-card p-3"><div class="small text-muted">Doanh thu hôm nay</div><div class="metric-number">@Model.RevenueToday.ToString("N0")<small>đ</small></div></div></div>
    <div class="col-6 col-lg"><div class="card metric-card p-3"><div class="small text-muted">Đã hoàn thành</div><div class="metric-number">@Model.CompletedAppointments</div></div></div>
    <div class="col-6 col-lg"><div class="card metric-card p-3"><div class="small text-muted">Khách mới tháng</div><div class="metric-number">@Model.NewCustomersThisMonth</div></div></div>
</div>
<div class="row g-4">
    <div class="col-lg-7"><div class="card p-4 h-100"><h5>Doanh thu 7 ngày</h5><canvas id="revenueChart" height="120"></canvas></div></div>
    <div class="col-lg-5"><div class="card p-4 h-100"><h5>Lịch sắp tới</h5><div class="table-responsive"><table class="table table-sm align-middle"><tbody>@foreach (var item in Model.UpcomingAppointments) { <tr><td><strong>@item.AppointmentDate.ToString("dd/MM")</strong><br /><small>@item.StartTime.ToString("hh\\:mm")</small></td><td>@item.Customer?.FullName<br /><small>@item.Service?.Name · @item.Stylist?.FullName</small></td><td><a class="btn btn-sm btn-outline-secondary" asp-controller="Appointments" asp-action="Details" asp-route-id="@item.Id">Xem</a></td></tr> }</tbody></table></div></div></div>
    <div class="col-lg-6"><div class="card p-4"><h5>Trạng thái lịch hẹn</h5><canvas id="statusChart" height="130"></canvas></div></div>
    <div class="col-lg-6"><div class="card p-4"><h5>Dịch vụ phổ biến</h5><canvas id="serviceChart" height="130"></canvas></div></div>
</div>
@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
const points = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueByDay));
const statuses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AppointmentStatusData));
const services = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PopularServices));
const palette = ['#b36f8d','#6b8e7b','#d79b52','#7868a8','#5f92ae'];
new Chart(document.getElementById('revenueChart'), { type: 'line', data: { labels: points.map(x=>x.Label), datasets:[{label:'VNĐ',data:points.map(x=>x.Value),borderColor:'#b36f8d',backgroundColor:'rgba(179,111,141,.15)',fill:true,tension:.35}] }, options:{plugins:{legend:{display:false}}} });
new Chart(document.getElementById('statusChart'), { type:'doughnut', data:{labels:statuses.map(x=>x.Label),datasets:[{data:statuses.map(x=>x.Value),backgroundColor:palette}]} });
new Chart(document.getElementById('serviceChart'), { type:'bar', data:{labels:services.map(x=>x.Label),datasets:[{data:services.map(x=>x.Value),backgroundColor:'#b36f8d'}]}, options:{plugins:{legend:{display:false}},scales:{y:{beginAtZero:true,ticks:{precision:0}}}} });
</script> }
