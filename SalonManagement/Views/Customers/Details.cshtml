@model CustomerDetailsViewModel
@{ ViewData["Title"] = "Chi tiết khách hàng"; var c = Model.Customer; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="page-title h2 mb-0">@c.FullName</h1><span class="text-muted">@c.Phone · @c.Email</span></div><div class="d-flex gap-2 flex-wrap"><a class="btn btn-primary" asp-controller="Appointments" asp-action="Create" asp-route-customerId="@c.Id">Đặt lịch</a><a class="btn btn-outline-primary" asp-controller="AI" asp-action="Recommendation" asp-route-customerId="@c.Id">AI gợi ý</a><a class="btn btn-outline-primary" asp-controller="AI" asp-action="Summary" asp-route-customerId="@c.Id">AI tóm tắt</a><a class="btn btn-outline-primary" asp-controller="AI" asp-action="Message" asp-route-customerId="@c.Id">AI tin nhắn</a></div></div>
<div class="row g-4"><div class="col-lg-4"><div class="card p-4 h-100"><h5>Thông tin</h5><dl class="row small"><dt class="col-5">Ngày sinh</dt><dd class="col-7">@(c.DateOfBirth?.ToString("dd/MM/yyyy") ?? "—")</dd><dt class="col-5">Giới tính</dt><dd class="col-7">@(c.Gender ?? "—")</dd><dt class="col-5">Địa chỉ</dt><dd class="col-7">@(c.Address ?? "—")</dd></dl><div class="border-top pt-3"><div class="text-muted small">Tổng chi tiêu</div><div class="h4">@Model.TotalSpent.ToString("N0")đ</div><div class="text-muted small">Dịch vụ thường dùng: @(Model.FavoriteService ?? "Chưa có")</div></div><p class="mt-3 small"><strong>Ghi chú:</strong> @(c.Notes ?? "Không có")</p><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@c.Id">Sửa thông tin</a></div></div><div class="col-lg-8"><div class="card p-4 mb-4"><h5>Lịch hẹn sắp tới</h5><table class="table table-sm"><tbody>@foreach(var x in Model.UpcomingAppointments){<tr><td>@x.AppointmentDate.ToString("dd/MM/yyyy") @x.StartTime.ToString("hh\\:mm")</td><td>@x.Service?.Name</td><td>@x.Stylist?.FullName</td><td><a asp-controller="Appointments" asp-action="Details" asp-route-id="@x.Id">Xem</a></td></tr>} @if(!Model.UpcomingAppointments.Any()){<tr><td class="text-muted">Chưa có lịch hẹn sắp tới.</td></tr>}</tbody></table></div><div class="card p-4"><h5>Lịch sử sử dụng dịch vụ</h5><table class="table table-sm align-middle"><thead><tr><th>Ngày</th><th>Dịch vụ</th><th>Thợ</th><th>Ghi chú</th></tr></thead><tbody>@foreach(var x in Model.Histories){<tr><td>@x.ServiceDate.ToString("dd/MM/yyyy")</td><td>@x.Service?.Name</td><td>@x.Stylist?.FullName</td><td>@x.Notes</td></tr>} @if(!Model.Histories.Any()){<tr><td colspan="4" class="text-muted">Chưa có lịch sử dịch vụ.</td></tr>}</tbody></table></div></div></div>
