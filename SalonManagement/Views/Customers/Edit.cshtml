@model Customer
@{ ViewData["Title"] = "Sửa khách hàng"; }
<div class="card form-card p-4"><h1 class="page-title h3">Cập nhật khách hàng</h1><form asp-action="Edit" class="mt-3"><input type="hidden" asp-for="Id"/><partial name="_Form" model="Model"/><div class="mt-4"><button class="btn btn-primary">Lưu thay đổi</button><a class="btn btn-link" asp-action="Details" asp-route-id="@Model.Id">Quay lại</a></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
