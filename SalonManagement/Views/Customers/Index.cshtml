@model IEnumerable<Customer>
@{ ViewData["Title"] = "Khách hàng"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="page-title h2">Khách hàng</h1><a class="btn btn-primary" asp-action="Create">+ Thêm khách hàng</a></div>
<form class="card card-body mb-3" method="get"><div class="input-group"><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Tìm theo tên, số điện thoại hoặc email" /><button class="btn btn-outline-secondary">Tìm</button></div></form>
<div class="card p-3 table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Họ tên</th><th>Điện thoại</th><th>Email</th><th>Ngày tạo</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td class="fw-semibold">@item.FullName</td><td>@item.Phone</td><td>@item.Email</td><td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td><td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Chi tiết</a><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Sửa</a></td></tr>}</tbody></table></div>
