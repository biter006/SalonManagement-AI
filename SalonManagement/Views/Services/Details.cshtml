@model SalonService
@{ ViewData["Title"]="Chi tiết dịch vụ"; }<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="page-title h2">@Model.Name</h1><div><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Sửa</a><a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Xóa</a></div></div><div class="card p-4"><p>@Model.Description</p><dl class="row"><dt class="col-sm-3">Giá</dt><dd class="col-sm-9">@Model.Price.ToString("N0")đ</dd><dt class="col-sm-3">Thời lượng</dt><dd class="col-sm-9">@Model.DurationMinutes phút</dd><dt class="col-sm-3">Trạng thái</dt><dd class="col-sm-9">@(Model.Status ? "Đang cung cấp" : "Ngừng cung cấp")</dd></dl></div>
