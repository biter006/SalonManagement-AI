@model IEnumerable<SalonService>
@{ ViewData["Title"]="Dịch vụ"; }<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="page-title h2">Dịch vụ</h1><a class="btn btn-primary" asp-action="Create">+ Thêm dịch vụ</a></div><form class="card card-body mb-3" method="get"><div class="row g-2"><div class="col-md-8"><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Tìm theo tên dịch vụ"/></div><div class="col-md-3"><select class="form-select" name="status"><option value="">Tất cả trạng thái</option><option value="true">Đang cung cấp</option><option value="false">Ngừng cung cấp</option></select></div><div class="col"><button class="btn btn-outline-secondary w-100">Lọc</button></div></div></form><div class="card p-3 table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Tên</th><th>Giá</th><th>Thời lượng</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><strong>@x.Name</strong><br/><small>@x.Description</small></td><td>@x.Price.ToString("N0")đ</td><td>@x.DurationMinutes phút</td><td><span class="badge bg-@(x.Status ? "success" : "secondary")">@(x.Status ? "Đang cung cấp" : "Ngừng")</span></td><td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@x.Id">Chi tiết</a><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@x.Id">Sửa</a></td></tr>}</tbody></table></div>
