@model Invoice
@{ ViewData["Title"]="Chi tiết hóa đơn"; }<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="page-title h2">Hóa đơn #@Model.Id</h1>@if(Model.PaymentStatus != PaymentStatus.Paid){<a class="btn btn-success" asp-action="Payment" asp-route-id="@Model.Id">Ghi nhận thanh toán</a>}</div><div class="card form-card p-4"><dl class="row"><dt class="col-sm-4">Khách hàng</dt><dd class="col-sm-8">@Model.Customer?.FullName</dd><dt class="col-sm-4">Lịch hẹn</dt><dd class="col-sm-8"><a asp-controller="Appointments" asp-action="Details" asp-route-id="@Model.AppointmentId">#@Model.AppointmentId · @Model.Appointment?.Service?.Name</a></dd><dt class="col-sm-4">Tổng tiền</dt><dd class="col-sm-8 h4">@Model.TotalAmount.ToString("N0")đ</dd><dt class="col-sm-4">Phương thức</dt><dd class="col-sm-8">@Model.PaymentMethod</dd><dt class="col-sm-4">Trạng thái</dt><dd class="col-sm-8">@Model.PaymentStatus</dd><dt class="col-sm-4">Đã thanh toán lúc</dt><dd class="col-sm-8">@(Model.PaidAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Chưa thanh toán")</dd></dl></div>
