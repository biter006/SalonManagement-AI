@model IEnumerable<Invoice>
@{ ViewData["Title"]="Hóa đơn"; }<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="page-title h2">Hóa đơn</h1><a class="btn btn-primary" asp-action="Create">+ Lập hóa đơn</a></div><div class="card p-3 table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Mã</th><th>Khách hàng</th><th>Tổng tiền</th><th>Thanh toán</th><th>Ngày tạo</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>#@x.Id</td><td>@x.Customer?.FullName</td><td>@x.TotalAmount.ToString("N0")đ</td><td><span class="badge bg-@(x.PaymentStatus == PaymentStatus.Paid ? "success" : "warning text-dark")">@x.PaymentStatus</span></td><td>@x.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td><td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@x.Id">Chi tiết</a></td></tr>}</tbody></table></div>
