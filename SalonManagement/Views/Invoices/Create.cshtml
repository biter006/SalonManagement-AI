@model InvoiceCreateViewModel
@{ ViewData["Title"] = "Lập hóa đơn"; }
<div class="card form-card p-4"><h1 class="page-title h3">Lập hóa đơn</h1><p class="text-muted">Tổng tiền được lấy từ dịch vụ của lịch hẹn đã hoàn thành.</p><form asp-action="Create"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="AppointmentId" class="form-label"></label><select asp-for="AppointmentId" asp-items="Model.Appointments" class="form-select"><option value="">-- Chọn lịch hẹn --</option></select></div><div class="mb-3"><label asp-for="PaymentMethod" class="form-label"></label><select asp-for="PaymentMethod" asp-items="Html.GetEnumSelectList<PaymentMethod>()" class="form-select"></select></div><button class="btn btn-primary">Lập hóa đơn</button><a class="btn btn-link" asp-action="Index">Hủy</a></form></div>
