@model Stylist
@{ ViewData["Title"]="Chi tiết thợ"; }<div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="page-title h2">@Model.FullName</h1><p class="text-muted">@Model.Specialization · @Model.Experience năm kinh nghiệm</p></div><div><a class="btn btn-primary" asp-controller="StylistSchedules" asp-action="Index" asp-route-stylistId="@Model.Id">Xem ca làm</a><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Sửa</a></div></div><div class="card p-4"><dl class="row"><dt class="col-sm-3">Điện thoại</dt><dd class="col-sm-9">@Model.Phone</dd><dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd><dt class="col-sm-3">Trạng thái</dt><dd class="col-sm-9">@Model.Status</dd></dl><h5 class="mt-3">Ca làm sắp tới</h5><ul class="mb-0">@foreach(var x in Model.Schedules.Where(x=>x.WorkDate >= DateTime.Today).OrderBy(x=>x.WorkDate).Take(10)){<li>@x.WorkDate.ToString("dd/MM/yyyy"): @x.StartTime.ToString("hh\\:mm") – @x.EndTime.ToString("hh\\:mm") (@x.Status)</li>}</ul></div>
