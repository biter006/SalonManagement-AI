@model IEnumerable<Stylist>
@{ ViewData["Title"] = "Quản lý thợ"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="page-title h2">Thợ làm tóc</h1><a class="btn btn-primary" asp-action="Create">+ Thêm thợ</a></div><div class="card p-3 table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Họ tên</th><th>Chuyên môn</th><th>Kinh nghiệm</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><strong>@x.FullName</strong><br/><small>@x.Phone</small></td><td>@x.Specialization</td><td>@x.Experience năm</td><td><span class="badge bg-@(x.Status == StylistStatus.Active ? "success" : "secondary")">@x.Status</span></td><td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@x.Id">Chi tiết</a><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@x.Id">Sửa</a></td></tr>}</tbody></table></div>
