@model CreateUserViewModel
@{ ViewData["Title"] = "Tạo tài khoản"; }
<div class="card form-card p-4"><h1 class="page-title h3">Tạo tài khoản</h1><form asp-action="Create" class="mt-3"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control"/></div><div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control"/></div><div class="mb-3"><label asp-for="Role" class="form-label"></label><select asp-for="Role" class="form-select">@foreach(string role in ViewBag.Roles){<option value="@role">@role</option>}</select></div><button class="btn btn-primary">Tạo tài khoản</button><a class="btn btn-link" asp-action="Index">Hủy</a></form></div>
