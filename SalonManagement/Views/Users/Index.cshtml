@model IEnumerable<UserRowViewModel>
@{ ViewData["Title"]="Tài khoản"; }<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="page-title h2">Tài khoản người dùng</h1><a class="btn btn-primary" asp-action="Create">+ Tạo tài khoản</a></div><div class="card p-3"><table class="table mb-0"><thead><tr><th>Email / tên đăng nhập</th><th>Vai trò</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Email</td><td>@x.Role</td></tr>}</tbody></table></div>
