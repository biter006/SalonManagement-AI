@model IEnumerable<StylistSchedule>
@{ ViewData["Title"]="Ca làm việc"; }<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="page-title h2">Lịch làm việc của thợ</h1>@if(User.IsInRole("Admin")){<a class="btn btn-primary" asp-action="Create">+ Thêm ca</a>}</div><form class="card card-body mb-3" method="get"><div class="row g-2"><div class="col-md-4"><input type="date" class="form-control" name="date" value="@ViewBag.Date"/></div><div class="col-md-5"><select name="stylistId" class="form-select" asp-items="ViewBag.Stylists"><option value="">Tất cả thợ</option></select></div><div class="col"><button class="btn btn-outline-secondary w-100">Lọc</button></div></div></form><div class="card p-3 table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Ngày</th><th>Thợ</th><th>Thời gian</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.WorkDate.ToString("dd/MM/yyyy")</td><td>@x.Stylist?.FullName</td><td>@x.StartTime.ToString("hh\\:mm") – @x.EndTime.ToString("hh\\:mm")</td><td>@x.Status</td><td class="text-end">@if(User.IsInRole("Admin")){<a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@x.Id">Sửa</a><a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@x.Id">Xóa</a>}</td></tr>}</tbody></table></div>
