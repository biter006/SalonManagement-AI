@model StylistSchedule
<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-12"><label asp-for="StylistId" class="form-label"></label><select asp-for="StylistId" asp-items="ViewBag.Stylists" class="form-select"><option value="">-- Chọn thợ --</option></select><span asp-validation-for="StylistId" class="text-danger"></span></div><div class="col-md-4"><label asp-for="WorkDate" class="form-label"></label><input asp-for="WorkDate" class="form-control"/><span asp-validation-for="WorkDate" class="text-danger"></span></div><div class="col-md-4"><label asp-for="StartTime" class="form-label"></label><input asp-for="StartTime" class="form-control"/></div><div class="col-md-4"><label asp-for="EndTime" class="form-label"></label><input asp-for="EndTime" class="form-control"/><span asp-validation-for="EndTime" class="text-danger"></span></div><div class="col-12"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<ScheduleStatus>()" class="form-select"></select></div></div>
